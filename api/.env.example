# ==============================================================================
# FinAuditPro Enterprise API Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting containers:
# cp api/.env.example api/.env
# ==============================================================================

# PostgreSQL Database Configuration
POSTGRES_DB=finauditpro
POSTGRES_USER=finaudit
POSTGRES_PASSWORD=generate_a_strong_password_here_2026

# Full Database URL (Overridden by FastAPI container)
FINAUDITPRO_DATABASE_URL=postgresql://finaudit:generate_a_strong_password_here_2026@db:5432/finauditpro

# JWT Secret Key for Bearer Token Authentication (Minimum 32 random characters)
# Generate via: python3 -c "import secrets; print(secrets.token_hex(32))"
FINAUDITPRO_JWT_SECRET=generate_a_secure_random_jwt_secret_key_here_32_chars

# CORS Allowed Origins (Comma-separated)
FINAUDIT_CORS_ORIGINS=http://localhost:3000,http://localhost:8000
