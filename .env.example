# ==============================================================================
# FinAuditPro — Environment Configuration Example File
# Copy to '.env' for local configuration. NEVER commit real secrets or credentials.
# ==============================================================================

# Application Data Directory Path (Default: ~/.gemini/antigravity-ide/app_data)
FINAUDITPRO_DATA_DIR=

# Local LM Studio AI Provider Configuration
LM_STUDIO_ENDPOINT=http://localhost:1234
LLM_MODEL_NAME=deepseek-r1-distill-qwen-14b
EMBEDDING_MODEL_NAME=nomic-embed-text

# Offline-First Privacy Posture (Default: false / strictly local)
ALLOW_CLOUD_AI=false

# Tesseract OCR Executable Override Path (Optional)
TESSERACT_PATH=/opt/homebrew/bin/tesseract

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
